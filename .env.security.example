# EXO 节点安全防护系统 - 轻量版配置
# =====================================
# 复制此文件为 .env.security 并根据实际环境修改
#
# ⚡ 设计理念: 默认关闭所有高级功能，零负担运行

# ===== 安全模式 =====
# strict  - 严格模式：启用所有检查（生产环境推荐）
# normal  - 正常模式：基础检查 + 速率限制（默认）
# relaxed - 宽松模式：仅记录警告，不阻止连接
# off     - 关闭模式：完全禁用安全检查（开发环境）
EXO_SECURITY_MODE=normal

# ===== 性能控制开关 (全部默认关闭或宽松) =====
# 是否启用速率限制 (默认: true)
# 开启后限制单IP连接频率，开销极小 (~0.01ms/次)
EXO_SECURITY_RATE_LIMIT=true

# 是否启用自动封禁 (默认: false) ⭐
# ⚠️ 建议保持关闭！除非确定需要自动封禁功能
# 开启后会占用更多内存和CPU资源
EXO_SECURITY_AUTO_BAN=false

# 是否启用详细日志 (默认: false) ⭐
# ⚠️ 生产环境建议关闭以节省I/O
EXO_SECURITY_LOGGING=false

# 是否启用高级功能 (默认: false) ⭐
# 包括: 风险评分、观察期、渐进惩罚等
# 仅在需要精细控制时开启
EXO_SECURITY_ADVANCED=false

# ===== 基础参数 (宽松默认值) =====
# 单IP每分钟最大连接次数 (默认: 30 - 非常宽松)
EXO_RATE_LIMIT_PER_MIN=30

# 单IP最大并发连接数 (默认: 10)
EXO_MAX_CONN_PER_IP=10

# 触发封禁的违规次数 (默认: 10 - 很宽容)
EXO_BAN_THRESHOLD=10

# 封禁时长(秒) (默认: 3600 = 1小时)
EXO_BAN_DURATION_SECS=3600

# 最大追踪IP数 (默认: 10000)
# 超过后会自动淘汰最旧的记录，防止内存无限增长
EXO_MAX_TRACKED_IPS=10000

# ===== IP 访问控制 (可选) =====
# IP白名单 (逗号分隔，支持CIDR格式)
# 留空 = 不启用白名单 (允许所有)
EXO_IP_WHITELIST=

# IP黑名单 (逗号分隔)
# 留空 = 不启用黑名单
EXO_IP_BLACKLIST=

# ===== 节点认证 (可选) =====
# 节点共享密钥
# 留空 = 禁用节点认证 (减少一次哈希计算)
# 设置后每个连接需要验证Token
EXO_NODE_AUTH_TOKEN=

# ===== 使用示例 =====
#
# ✅ 推荐配置 (零负担):
# ----------------------
# EXO_SECURITY_MODE=normal
# EXO_SECURITY_RATE_LIMIT=true
# EXO_SECURITY_AUTO_BAN=false      # 关闭!
# EXO_SECURITY_LOGGING=false       # 关闭!
# EXO_SECURITY_ADVANCED=false      # 关闭!
# # 其他保持默认即可
#
# 🔒 高安全性配置:
# -----------------
# EXO_SECURITY_MODE=strict
# EXO_SECURITY_AUTO_BAN=true        # 启用自动封禁
# EXO_RATE_LIMIT_PER_MIN=10         # 更严格的限制
# EXO_BAN_THRESHOLD=5               # 更容易触发封禁
# EXO_IP_WHITELIST=<你的服务器IP>/32
# EXO_NODE_AUTH_TOKEN=<强随机密码>
#
# 🚀 性能优先配置:
# ------------------
# EXO_SECURITY_MODE=off             # 完全关闭
# # 或者直接不创建 .env.security 文件
#
# 🛠️ 开发调试配置:
# -------------------
# EXO_SECURITY_MODE=relaxed
# EXO_SECURITY_LOGGING=true         # 开启日志查看详情
# EXO_SECURITY_ADVANCED=true        # 开启高级功能测试
