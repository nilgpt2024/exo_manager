# ===========================================
# Docker 构建排除文件
# ===========================================

# Git
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so
.pytest_cache
.coverage
htmlcov
.tox
.nox
.mypy_cache
.ruff_cache

# 虚拟环境
.venv
venv
ENV
env
.env.local
.env.*.local

# IDE
.vscode
.idea
*.swp
*.swo
*~

# 数据文件 (运行时生成, 不打包进镜像)
data/
logs/
*.db
*.sqlite3
users.json
api_keys.json
wechat_config.json

# 文档和报告
*.md
SECURITY_*.md
LICENSE
CHANGELOG*

# Docker 相关 (避免递归)
Dockerfile*
docker-compose*.yml
.dockerignore
docker/

# 测试文件
test_*.py
*_test.py
tests/

# 临时文件
*.tmp
*.temp
*.bak
*.log

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# 敏感配置 (不应提交到镜像)
.env
*.key
*.pem
*.crt
