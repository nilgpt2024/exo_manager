# ===========================================
# EXO Cluster Manager 环境变量配置模板
# ===========================================
#
# 使用方法:
#   1. 复制此文件为 .env:  cp .env.example .env
#   2. 根据实际环境修改配置
#   3. 生产环境: 确保 .env 文件权限为 600 (仅所有者可读写)
#
# 加载方式:
#   - Python: python-dotenv 或直接 os.getenv()
#   - Docker: docker run --env-file .env
#   - Kubernetes: ConfigMap / Secrets
#

# ==========================================
# 基础配置
# ==========================================

# 运行环境 (development / production)
# production 模式会启用严格安全策略
EXO_ENV=development

# 是否强制 HTTPS
# 启用后 Cookie 会设置 Secure 标志, HSTS 响应头
EXO_FORCE_HTTPS=false

# CORS 开发模式
# true = 允许所有来源 (仅用于本地调试!)
# false = 使用 EXO_CORS_ORIGINS 白名单
EXO_DEV_MODE=true

# 允许的跨域来源 (逗号分隔的域名列表)
EXO_CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080


# ==========================================
# 管理员账号配置
# ==========================================

# 默认管理员密码
# - 生产环境必须设置强密码!
# - 如果不设置, 首次登录需使用 EXO_INIT_PASSWORD
# 建议: 至少 12 位, 包含大小写字母+数字+特殊字符
EXO_ADMIN_DEFAULT_PASSWORD=

# 首次初始化密码
# 仅在首次启动且无管理员用户时使用
# 登录后请立即修改密码!
EXO_INIT_PASSWORD=admin_init_2024!


# ==========================================
# 微信登录配置 (可选)
# ==========================================

# 微信开放平台 - 网站应用
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:8080/auth/wechat/callback
WECHAT_SCOPE=snsapi_login
WECHAT_STATE_PREFIX=exo_

# 微信小程序 (可选)
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=


# ==========================================
# 数据库配置 (未来迁移使用)
# ==========================================

# SQLite 路径 (当前默认)
# EXO_DB_PATH=./data/exo_manager.db

# PostgreSQL (待实现)
# EXO_DB_HOST=localhost
# EXO_DB_PORT=5432
# EXO_DB_NAME=exo_manager
# EXO_DB_USER=exo
# EXO_DB_PASSWORD=


# ==========================================
# 日志配置
# ==========================================

# 日志级别 (DEBUG / INFO / WARNING / ERROR)
EXO_LOG_LEVEL=INFO

# 日志文件路径 (可选, 不设置则仅输出到控制台)
# EXO_LOG_FILE=/var/log/exo_manager/server.log


# ==========================================
# 安全高级选项 (一般无需修改)
# ==========================================

# Session 有效期 (秒), 默认 7 天
# EXO_SESSION_EXPIRY=604800

# 最大登录尝试次数
# EXO_MAX_LOGIN_ATTEMPTS=5

# 锁定时间 (秒), 默认 15 分钟
# EXO_LOGIN_LOCKOUT_TIME=900

# bcrypt 工作因子 (越高越安全但越慢, 推荐 10-14)
# EXO_BCRYPT_ROUNDS=12


# ==========================================
# API 速率限制配置
# ==========================================

# 是否启用速率限制 (默认 true)
EXO_RATE_LIMIT_ENABLED=true

# 全局请求限制: 每个时间窗口内最大请求数
EXO_RATE_LIMIT_REQUESTS=100

# 时间窗口 (秒)
EXO_RATE_LIMIT_WINDOW=60

# 白名单 IP (不受速率限制, 逗号分隔, 例如: 192.168.1.100,10.0.0.5)
EXO_RATE_LIMIT_WHITELIST=


# ==========================================
# IP 访问控制配置
# ==========================================

# 是否启用 IP 过滤 (默认 false)
EXO_IP_FILTER_ENABLED=false

# 使用白名单模式 (true = 仅允许白名单IP, false = 仅拒绝黑名单IP)
EXO_IP_WHITELIST_MODE=false

# 白名单 IP (逗号分隔)
EXO_IP_WHITELIST=

# 黑名单 IP (逗号分隔)
EXO_IP_BLACKLIST=

# 需要严格控制的路径前缀 (管理员接口等, 逗号分隔)
EXO_IP_ADMIN_PATHS=/admin


# ==========================================
# 密码策略配置
# ==========================================

# 最小密码长度
EXO_PASSWORD_MIN_LENGTH=8

# 最大密码长度
EXO_PASSWORD_MAX_LENGTH=128

# 是否要求密码复杂度 (大小写+数字+特殊字符)
EXO_PASSWORD_REQUIRE_COMPLEXITY=true

# 密码有效期 (天), 0 表示永不过期
EXO_PASSWORD_EXPIRY_DAYS=90


# ==========================================
# 审计日志配置
# ==========================================

# 是否启用审计日志 (默认 true)
EXO_AUDIT_ENABLED=true

# 审计日志文件路径
# EXO_AUDIT_LOG_FILE=./logs/audit.log

# 单个日志文件最大大小 (MB)
# EXO_AUDIT_MAX_SIZE=10

# 保留的备份文件数
# EXO_AUDIT_BACKUP_COUNT=5


# ==========================================
# 数据加密配置
# ==========================================

# 主加密密钥 (Base64 编码的 32 字节密钥)
# - 生产环境必须设置!
# - 可通过以下命令生成:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
EXO_ENCRYPTION_KEY=

# 数据库功能开关
# true = 使用 SQLite 存储用户/API Key 数据
# false = 继续使用 JSON 文件 (向后兼容)
EXO_DB_ENABLE=false

# SQLite 数据库文件路径 (仅在 EXO_DB_ENABLE=true 时生效)
EXO_DB_PATH=./data/exo_manager.db


# ==========================================
# 调试选项 (生产环境必须关闭!)
# ==========================================

# 调试模式 (会暴露更多错误详情)
EXO_DEBUG=false
